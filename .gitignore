__pycache__/
*.pyc

# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100/
.Trashes/
Thumbs.db
ehthumbs.db
Desktop.ini

# Python / tooling noise
*.log
*.tmp
*.swp
*.swo

# Local data link/helper path
data_library

# Local copies of published papers (large binaries; keep out of git by default)
published_works/*.pdf

# Large extraction artifacts generated during PDF/notebook panel matching
results/reproduction/*-paper-pdf-extract/
results/reproduction/*/pdf_extract/
results/reproduction/*/notebook_extract/

# Microsoft Office lock files (created when Excel/Word workbook is open)
~$*.xlsx
~$*.xls
~$*.docx
~$*.doc

# Claude Code session state (worktree copies, agent metadata)
.claude/

# Stray simulation output CSVs (model writes to cwd by default — should land
# in results/ directories, not at repo root or alongside source code).
sim_data-*.csv
