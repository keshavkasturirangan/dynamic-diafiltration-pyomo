__pycache__/
*.pyc

# macOS
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100/
.Trashes/
Thumbs.db
ehthumbs.db
Desktop.ini

# Python / tooling noise
*.log
*.tmp
*.swp
*.swo

# Local data link/helper path
data_library

# Local copies of published papers (large binaries; keep out of git by default)
published_works/*.pdf

# Large extraction artifacts generated during PDF/notebook panel matching
results/reproduction/*-paper-pdf-extract/
results/reproduction/*/pdf_extract/
results/reproduction/*/notebook_extract/

# Microsoft Office lock files (created when Excel/Word workbook is open)
~$*.xlsx
~$*.xls
~$*.docx
~$*.doc

# Claude Code session state (worktree copies, agent metadata)
.claude/

# Stray simulation output CSVs (model writes to cwd by default — should land
# in results/ directories, not at repo root or alongside source code).
sim_data-*.csv

# DATA1 path-construction bug artifact: a writer somewhere occasionally builds
# `<data1_root>/data1/...` instead of `<data1_root>/notebook_figures/...` and
# spills ~50 MB of figures into the wrong place. Ignore the bad output until
# the writer is fixed; the bug is tracked separately.
UnifiedFramework/DATA3/results/paper_artifacts/data1/data1/

# NF270 experimental snapshots — exploratory runs that produce zip dumps and
# scratch directories alongside the real paper artifacts. None of these are
# inputs to the published-figure pipeline. The originally-tracked items under
# nf270/ (paper figures, campaign_figures.zip series 2-6) are unaffected by
# these patterns (.gitignore does not apply to tracked files).
UnifiedFramework/DATA3/results/paper_artifacts/nf270/cf_floor_test*
UnifiedFramework/DATA3/results/paper_artifacts/nf270/contour_panels*
UnifiedFramework/DATA3/results/paper_artifacts/nf270/paper_style_test/
UnifiedFramework/DATA3/results/paper_artifacts/nf270/paper_styling_preview/
UnifiedFramework/DATA3/results/paper_artifacts/nf270/regime_gated_fits*
# Finder-style duplicates of nf270/campaign_figures.zip (e.g. "… 7.zip", "… 8.zip")
UnifiedFramework/DATA3/results/paper_artifacts/nf270/campaign_figures [0-9].zip

# PowerPoint/Word lock files (open-document temporaries)
~$*.pptx
~$*.ppt

# Generated DATA3 B-form campaign artifacts (reproducible outputs: contours,
# result_*.json, gifs, master-curve/Taylor/Peclet figures). Decks embed the
# figures they need, so these large machine-generated trees stay out of git.
UnifiedFramework/DATA3/results/paper_artifacts/nf270/bform_study/

# Transient parallel-worker markers dropped by the campaign runners
**/WORKER_DONE
*.skip

# QA slide-render scratch (regenerated on demand from the .pptx via LibreOffice)
refactored_codes_v1/_collab_update_build/*.jpg
